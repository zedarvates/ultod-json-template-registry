{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Professions Configuration Schema",
  "description": "Schema for validating professions configuration templates",
  "type": "object",
  "required": [
    "template_type",
    "version",
    "name",
    "description",
    "global_settings"
  ],
  "properties": {
    "template_type": {
      "type": "string",
      "enum": [
        "professions"
      ],
      "description": "Type of template"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version number in semantic versioning format"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Name of the professions configuration"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Description of the professions configuration"
    },
    "global_settings": {
      "type": "object",
      "required": [
        "enabled",
        "debug_mode",
        "log_level"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the system is enabled"
        },
        "debug_mode": {
          "type": "boolean",
          "description": "Whether debug mode is enabled"
        },
        "log_level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Logging level"
        },
        "max_professions_per_player": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of professions per player"
        },
        "profession_level_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum level for each profession"
        },
        "skill_points_per_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Skill points gained per profession level"
        },
        "auto_cleanup_interval_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Auto cleanup interval in days"
        },
        "performance_optimization": {
          "type": "object",
          "properties": {
            "enable_caching": {
              "type": "boolean"
            },
            "cache_ttl_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "batch_processing": {
              "type": "boolean"
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "async_processing": {
              "type": "boolean"
            },
            "thread_pool_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        }
      }
    },
