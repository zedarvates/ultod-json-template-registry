{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimateodycer.com/schemas/game-ui/1.0.0",
  "title": "Ultimate Odycer game UI template v1",
  "allOf": [
    {
      "$ref": "https://ultimateodycer.com/schemas/template-contract/1.0.0"
    },
    {
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "display_name",
            "theme",
            "components",
            "windows",
            "features"
          ],
          "properties": {
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "theme": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "region",
                  "movable",
                  "resizable"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "maxLength": 64
                  },
                  "kind": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "maxLength": 64
                  },
                  "region": {
                    "enum": [
                      "top-left",
                      "top-center",
                      "top-right",
                      "right",
                      "bottom-left",
                      "bottom-center",
                      "bottom-right"
                    ]
                  },
                  "movable": {
                    "type": "boolean"
                  },
                  "resizable": {
                    "type": "boolean"
                  },
                  "max_slots": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  }
                },
                "additionalProperties": false
              }
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "uniqueItems": true,
              "maxItems": 64
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "uniqueItems": true,
              "maxItems": 64
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
