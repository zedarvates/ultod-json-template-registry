{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spell Template Schema",
  "description": "Schema for spell templates",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "icon",
    "school",
    "rarity",
    "spell_type",
    "target_type",
    "range",
    "cast_time",
    "cooldown",
    "mana_cost",
    "damage",
    "effects",
    "visual_effects",
    "sound_effects",
    "requirements",
    "template_type",
    "version"
  ],
  "properties": {
    "template_type": {
      "type": "string",
      "enum": [
        "spell"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "type": "string",
      "enum": [
        "fire",
        "frost",
        "arcane",
        "nature",
        "shadow",
        "holy",
        "lightning",
        "earth",
        "water",
        "wind",
        "chaos",
        "order"
      ]
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ]
    },
    "spell_type": {
      "type": "string",
      "enum": [
        "damage_instant",
        "damage_over_time",
        "healing_instant",
        "healing_over_time",
        "buff",
        "debuff",
        "summon",
        "teleport",
        "transformation",
        "control",
        "elemental_damage_projectile",
        "area_damage",
        "single_target_heal",
        "group_heal"
      ]
    },
    "target_type": {
      "type": "string",
      "enum": [
        "self",
        "enemy",
        "ally",
        "enemy_or_location",
        "location",
        "area"
      ]
    },
    "range": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "cast_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000
    },
    "cooldown": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    },
    "mana_cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "damage": {
      "type": "object",
      "properties": {
        "base_damage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "damage_type": {
          "type": "string",
          "enum": [
            "physical_damage",
            "fire_elemental_damage",
            "frost_elemental_damage",
            "arcane_damage",
            "nature_damage",
            "shadow_damage",
            "holy_damage",
            "lightning_damage",
            "earth_damage",
            "water_damage",
            "chaos_damage"
          ]
        },
        "scaling": {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string",
              "enum": [
                "intelligence",
                "wisdom",
                "strength",
                "agility"
              ]
            },
            "coefficient": {
              "type": "number",
              "minimum": 0,
              "maximum": 5.0
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "effect_type",
          "value",
          "duration",
          "tick_rate"
        ],
        "properties": {
          "effect_type": {
            "type": "string",
            "enum": [
              "explosive_fire_projectile",
              "frost_slow",
              "arcane_missile_barrage",
              "healing_wave",
              "damage_over_time",
              "buff_strength",
              "debuff_weakness",
              "summon_minion",
              "teleport_location",
              "stun_effect",
              "knockback"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000
          },
          "tick_rate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "explosion_radius": {
            "type": "number",
            "minimum": 0,
            "maximum": 50
          },
          "projectile_speed": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "fire_damage_over_time": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "impact_blast_wave": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "debris_scatter_damage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "flammable_terrain_ignition": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.0
          }
        }
      }
    },
    "visual_effects": {
      "type": "object",
      "properties": {
        "cast_effect": {
          "type": "string"
        },
        "projectile_effect": {
          "type": "string"
        },
        "explosion_effect": {
          "type": "string"
        },
        "impact_effect": {
          "type": "string"
        },
        "aura_effect": {
          "type": "string"
        },
        "trail_effect": {
          "type": "string"
        }
      }
    },
    "sound_effects": {
      "type": "object",
      "properties": {
        "cast_effect": {
          "type": "string"
        },
        "projectile_effect": {
          "type": "string"
        },
        "explosion_effect": {
          "type": "string"
        },
        "impact_effect": {
          "type": "string"
        },
        "loop_effect": {
          "type": "string"
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specializations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "races": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "upgrades": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "properties": {
            "unlock_level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "description": {
              "type": "string"
            },
            "damage_increase_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "explosion_radius_increase": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "projectile_speed_increase": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "explosion_chain_reactions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "terraforming_fire_crater": {
              "type": "boolean"
            },
            "uncontrollable_wildfire_risk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.0
            },
            "meteor_strike_visuals": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "vr_configuration": {
      "type": "object",
      "properties": {
        "gestures": {
          "type": "object",
          "properties": {
            "left_pose": {
              "type": "string",
              "enum": [
                "open",
                "fist",
                "point",
                "pinch",
                "grab"
              ]
            },
            "right_pose": {
              "type": "string",
              "enum": [
                "open",
                "fist",
                "point",
                "pinch",
                "grab"
              ]
            },
            "required_hand": {
              "type": "string",
              "enum": [
                "left",
                "right",
                "both",
                "either"
              ]
            }
          }
        },
        "haptics": {
          "type": "object",
          "properties": {
            "charge_pattern": {
              "type": "string"
            },
            "launch_pattern": {
              "type": "string"
            },
            "impact_pattern": {
              "type": "string"
            }
          }
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "id": "spell_schema"
}
